{
  "name": "ConversationRequest",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string",
      "description": "User ID of the requester"
    },
    "from_display_name": {
      "type": "string"
    },
    "from_photo": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string",
      "description": "User ID of the recipient"
    },
    "to_display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "blocked"
      ],
      "default": "pending"
    }
  },
  "required": [
    "from_user_id",
    "to_user_id"
  ]
}
