{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string"
    },
    "reported_display_name": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "fake_profile",
        "inappropriate_photo",
        "harassment",
        "spam",
        "underage",
        "other"
      ]
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_id",
    "reported_user_id",
    "reason"
  ]
}
